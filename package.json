{
  "name": "worminal-file-explorer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "lint": "node --import ./tools/hyperlint/node_modules/tsx/dist/loader.mjs tools/hyperlint/src/cli.ts --format=text",
    "check": "tsc --noEmit && npm run build && node tools/check.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vite-plugin-singlefile": "2.3.0"
  }
}
